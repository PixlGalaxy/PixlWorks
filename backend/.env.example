# --- Ollama (Zaylar server) ---------------------------------------------
OLLAMA_HOST=http://192.168.0.150:11434
# Target model. If this exact tag is not installed, the backend falls back to
# the first installed model whose name contains "gemma" (see ollama.py).
OLLAMA_MODEL=gemma4:e4b
# Cold loads into VRAM can take a while, so the generation timeout is generous.
OLLAMA_TIMEOUT=180
# Short timeout used only for health/status probes so the UI never hangs.
OLLAMA_PROBE_TIMEOUT=2.5
# gemma4:e4b is a thinking model and its reasoning tokens count against
# MAX_OUTPUT_TOKENS, which truncates the visible answer. Leave this false.
OLLAMA_THINK=false

# --- Local development ---------------------------------------------------
# Skips the Origin check so curl/Postman work while debugging. Never in prod.
# localhost origins are always accepted regardless of this flag.
DEV_MODE=false
# DEBUG also re-enables httpx's one-line-per-request logging.
LOG_LEVEL=INFO

# --- CORS ----------------------------------------------------------------
ALLOWED_ORIGINS=https://pixlworks.itzgalaxy.com,http://localhost:5173,http://localhost:4173

# --- Abuse protection ----------------------------------------------------
RATE_LIMIT_BURST=8
RATE_LIMIT_WINDOW=300
RATE_LIMIT_DAILY=40
MAX_CONCURRENT=2
MAX_MESSAGE_CHARS=600
MAX_HISTORY_TURNS=6
MAX_OUTPUT_TOKENS=400

# --- Leads ---------------------------------------------------------------
LEADS_FILE=data/leads.jsonl
LEAD_LIMIT_HOURLY=3
